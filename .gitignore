# Build outputs. Scoped to build directories on purpose: *.exe and *.dll are
# NOT blanket-ignored, because pkg/bin/ has to be committed.
build/
**/build/

# Python
.venv/
__pycache__/

# Editors / OS
.vs/
.DS_Store
Thumbs.db

# Simulator output. runs/fixture.jsonl, fixture.json and fixture.meta.json
# are the committed test fixture. The binary is regenerable and stays out.
runs/*.jsonl
runs/*.json
runs/*.bin
runs/*.png
!runs/fixture.jsonl
!runs/fixture.json
!runs/fixture.meta.json

# Ablation traces and viewer sidecars. Regenerable; too large for git.
runs/*/

# Unity (viewer/<project>/). Nested so a Hub project under viewer/ is covered.
viewer/**/Library/
viewer/**/Temp/
viewer/**/Obj/
viewer/**/Build/
viewer/**/Logs/
viewer/**/UserSettings/
viewer/**/*.csproj
viewer/**/*.sln

# NOTE: pkg/ is deliberately NOT ignored -- the challenge package is committed.
runs/sweep/
