# Build outputs. Scoped to build directories on purpose: *.exe and *.dll are
# NOT blanket-ignored, because pkg/bin/ has to be committed.
build/
**/build/

# Python
.venv/
__pycache__/

# Editors / OS
.vs/
.DS_Store
Thumbs.db

# Simulator output. runs/fixture.* is a committed test fixture, so keep it.
runs/*.jsonl
runs/*.json
runs/*.bin
!runs/fixture.*

# Unity (viewer/)
viewer/Library/
viewer/Temp/
viewer/Obj/
viewer/Build/
viewer/Logs/
viewer/UserSettings/
viewer/*.csproj
viewer/*.sln

# NOTE: pkg/ is deliberately NOT ignored -- the challenge package is committed.
